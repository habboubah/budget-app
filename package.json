{
  "name": "spartopf",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3002 --host=0.0.0.0",
    "build": "vite build && npx cap sync",
    "build:web": "vite build",
    "build:ios": "vite build && npx cap sync ios && npx cap open ios",
    "assets:generate": "npx @capacitor/assets generate --ios --iconBackgroundColor '#10313A' --splashBackgroundColor '#F2F2F7' --splashBackgroundColorDark '#000000'",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "node scripts/release.js",
    "release:ios": "node scripts/release.js",
    "release:first": "node scripts/release.js --keep-version",
    "release:dry": "node scripts/release.js --dry-run",
    "preview": "vite preview --port=3002 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "fflate": "^0.8.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
