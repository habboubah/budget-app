{
  "name": "spartopf",
  "private": true,
  "version": "1.2.17",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3002 --host=0.0.0.0",
    "build": "vite build && npx cap sync",
    "build:web": "vite build",
    "build:ios": "vite build && npx cap sync ios && npx cap open ios",
    "build:android": "vite build && npx cap sync android && npx cap open android",
    "android:debug": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "assets:generate": "npx @capacitor/assets generate --ios --iconBackgroundColor '#076070' --splashBackgroundColor '#F2F2F7' --splashBackgroundColorDark '#000000'",
    "screenshots": "node scripts/screenshots.mjs",
    "guide-shots": "node scripts/guide-shots.mjs",
    "rehearse:app-review": "node scripts/rehearse-app-review.mjs",
    "record:app-review": "bash scripts/record-app-review.sh",
    "record:watch": "bash scripts/record-watch.sh",
    "store-screenshots": "node .claude/skills/store-screenshot-studio/scripts/export.mjs && node .claude/skills/store-screenshot-studio/scripts/feature_graphic.mjs && node .claude/skills/store-screenshot-studio/scripts/preview.mjs && python3 .claude/skills/store-screenshot-studio/scripts/validate.py",
    "release": "node scripts/release.js",
    "release:ios": "node scripts/release.js --ios",
    "release:android": "node scripts/release.js --android",
    "android:key": "node scripts/release-android.js --make-key",
    "release:first": "node scripts/release.js --ios --keep-version",
    "release:dry": "node scripts/release.js --dry-run",
    "preview": "vite preview --port=3002 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run check:security && npm test && vite build && npm run check:privacy -- --no-build && npm run check:perf -- --no-build && npm run audit:contrast",
    "check:security": "node scripts/no-console.mjs && npm audit --omit=dev --audit-level=high",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:perf": "node scripts/perf-check.mjs",
    "ocr:copy": "node scripts/copy-ocr.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@tesseract.js-data/deu": "1.0.0",
    "fflate": "0.8.3",
    "lucide-react": "0.546.0",
    "motion": "12.41.0",
    "pdfjs-dist": "6.5.438",
    "qr": "0.7.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
