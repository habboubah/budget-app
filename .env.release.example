# Copy to .env.release (gitignored) and fill in. Read by scripts/release.js.
#
# The App Store Connect API key is per team, not per app: the key that ships
# pizza-driver-log (Fahrtwerk) ships Haushaltsbuch Einfach too — copy the two lines from
# pizza-driver-log/.env.release.
#
# App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: where the AuthKey_<ASC_KEY_ID>.p8 file lives. Default:
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# ASC_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# ---- Android (scripts/release-android.js, docs/ANDROID_RELEASE.md) ----
# The upload key: make it once (keytool, see the doc), keep the file and its
# password somewhere safe outside the repository, and never commit either.
# ANDROID_KEYSTORE_PATH=/Users/you/keys/spartopf-upload.jks
# Left out, the first release asks for it once and adds this line itself.
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=spartopf
# Optional; defaults to the keystore's password.
# ANDROID_KEY_PASSWORD=
# The Play service account's JSON key — `npm run release:android` uploads with
# it. A service account belongs to the developer account, not to one app: copy
# the line from pizza-driver-log/.env.release and give that account Haushaltsbuch Einfach
# in the Play Console (Users and permissions › Release apps to testing tracks).
# PLAY_SERVICE_ACCOUNT_JSON=/Users/you/keys/play-service-account.json
# Optional: the test track to release on — internal (default), alpha, beta.
# PLAY_TRACK=internal
