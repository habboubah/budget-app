<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- destination=upload makes `xcodebuild -exportArchive` upload straight to
	     App Store Connect (TestFlight). No secrets in here — auth comes from the
	     -authenticationKey* flags in scripts/release.js. Same as pizza-driver-log. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>HZVBBHBAJN</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- scripts/release.js owns all version/build numbers; don't let Xcode re-bump. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
